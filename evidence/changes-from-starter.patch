+name: Android M0 build
+on:
+  workflow_dispatch:
+  pull_request:
+  push:
+    branches: [main, master]
+permissions:
+  contents: read
+concurrency:
+  group: android-m0-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  validate:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4, resolved 2026-09-28
+        with:
+          persist-credentials: false
+      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - name: Install explicit SDK packages
+        shell: bash
+        run: |
+          set -euo pipefail
+          SDK_ROOT="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
+          test -n "$SDK_ROOT"
+          SDKMANAGER="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"
+          test -x "$SDKMANAGER"
+          # Hosted runner SDK license state is used; no account/payment/production credentials.
+          "$SDKMANAGER" --sdk_root="$SDK_ROOT" "platforms;android-37" "build-tools;36.0.0" "platform-tools"
+          echo "ANDROID_HOME=$SDK_ROOT" >> "$GITHUB_ENV"
+      - name: Verify bootstrap and build
+        shell: bash
+        run: |
+          set -euo pipefail
+          chmod +x gradlew build.sh scripts/*.sh
+          python3 scripts/verify_source.py
+          ./build.sh
+          # Compile the instrumented test package; this does NOT execute device tests.
+          ./gradlew --no-daemon --console=plain :app:assembleDebugAndroidTest
+          "$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --verbose app/build/outputs/apk/debug/app-debug.apk | tee .build-output/apk-signature.log
+          python3 scripts/collect_build_evidence.py
+      - name: Attach Debug APK after successful validation
+        if: success()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: gccwebos-m0-debug-${{ github.sha }}
+          path: |
+            app/build/outputs/apk/debug/*.apk
+            .build-output/build-manifest.json
+          include-hidden-files: true
+          if-no-files-found: error
+          retention-days: 14
+      - name: Attach validation logs even on failure
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: gccwebos-m0-reports-${{ github.sha }}
+          path: |
+            .build-output/*.log
+            app/build/test-results/
+            app/build/reports/
+          include-hidden-files: true
+          if-no-files-found: warn
+          retention-days: 14
