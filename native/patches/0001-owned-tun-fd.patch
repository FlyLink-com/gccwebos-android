+
+// NewWithOwnedFD transfers FileDescriptor on entry, including error paths. Added by
+// GCC Web OS Android bridge: caller must not close the transferred descriptor.
+func NewWithOwnedFD(options LC.Tun, tunnel C.Tunnel, additions ...inbound.Addition) (l *Listener, err error) {
+	unclaimed := options.FileDescriptor > 0
+	defer func() {
+		if unclaimed {
+			_ = os.NewFile(uintptr(options.FileDescriptor), "gcc-tun-unclaimed").Close()
+		}
+	}()
+	return newWithOwnership(options, tunnel, func() { unclaimed = false }, additions...)
+}
